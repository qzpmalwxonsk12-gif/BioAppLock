<Window x:Class="BioAppLock.LockShieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BioShield Security Prompt — Authentication Required"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#F8060A12"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Grid>
        <!-- Subtle Radial Security Glow Background -->
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.7" RadiusY="0.7">
                <GradientStop Color="#1E1E38" Offset="0.0"/>
                <GradientStop Color="#060A12" Offset="1.0"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Center Security Notification Card -->
        <Border Width="540"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1.5"
                CornerRadius="18"
                Padding="34,30,34,28">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="45" ShadowDepth="12" Opacity="0.85"/>
            </Border.Effect>

            <StackPanel>
                <!-- Top Security Badge -->
                <Border Background="#26F59E0B"
                        BorderBrush="#66F59E0B"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡️" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SECURITY INTERCEPTION — BIOMETRIC / PIN REQUIRED"
                                   Foreground="#FBBF24"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Lock Icon Circle -->
                <Border Width="72" Height="72"
                        CornerRadius="36"
                        Background="#1E293B"
                        BorderBrush="#38BDF8"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <TextBlock Text="🔒"
                               FontSize="32"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Main Heading -->
                <TextBlock Text="Protected Application Locked"
                           Foreground="#F8FAFC"
                           FontSize="23"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Verify your identity with laptop Fingerprint or Windows Hello PIN before viewing the contents of this application."
                           Foreground="#94A3B8"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           LineHeight="20"
                           Margin="0,0,0,20"/>

                <!-- Target Application Details Box -->
                <Border Background="#090D16"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,14"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="42" Height="42"
                                CornerRadius="10"
                                Background="#1E293B"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                            <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AppNameText"
                                       Text="Antigravity IDE"
                                       Foreground="#F8FAFC"
                                       FontSize="15.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="WindowDetailsText"
                                       Text="Process: Antigravity.exe • Contents shielded &amp; running in background"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Live Biometric Status Banner -->
                <Border x:Name="StatusBanner"
                        Background="#172554"
                        BorderBrush="#1D4ED8"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,18">
                    <TextBlock x:Name="StatusMessageText"
                               Text="🔍 Activating Windows Hello Fingerprint / PIN prompt..."
                               Foreground="#93C5FD"
                               FontSize="13"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>

                <!-- Primary Windows Hello Button -->
                <Button x:Name="VerifyHelloButton"
                        Click="VerifyHelloButton_Click"
                        Height="46"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14.5"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,0,14">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="16,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#1E3A8A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🫆" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VerifyButtonLabel" Text="Authenticate with Fingerprint / Windows PIN" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Optional Backup Master PIN Section -->
                <Border x:Name="BackupPinPanel"
                        Background="#090D16"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Backup PIN:"
                                   Foreground="#94A3B8"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <PasswordBox x:Name="PinPasswordBox"
                                     Grid.Column="1"
                                     Height="32"
                                     Background="#1E293B"
                                     Foreground="White"
                                     BorderBrush="#334155"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     Margin="0,0,10,0"
                                     KeyDown="PinPasswordBox_KeyDown"/>
                        <Button Grid.Column="2"
                                Content="Unlock via PIN"
                                Click="UnlockWithPinButton_Click"
                                Height="32"
                                Padding="14,0"
                                Background="#334155"
                                Foreground="#F8FAFC"
                                BorderThickness="0"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Cancel / Keep Minimized Button -->
                <Button x:Name="CancelLockButton"
                        Click="CancelLockButton_Click"
                        Height="38"
                        Background="Transparent"
                        Foreground="#94A3B8"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        FontSize="13"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cancelBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cancelBorder" Property="Background" Value="#1E293B"/>
                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="✕  Cancel &amp; Keep Application Minimized (Do Not Open)"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
