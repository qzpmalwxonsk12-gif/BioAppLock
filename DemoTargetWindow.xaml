<Window x:Class="BioAppLock.DemoTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confidential Workspace [CONFIDENTIAL-DEMO] — Running Background Task"
        Width="680" Height="440"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120">

    <Grid Margin="24">
        <Border Background="#111827"
                BorderBrush="#10B981"
                BorderThickness="1.5"
                CornerRadius="14"
                Padding="26">
            <StackPanel>
                <Border Background="#1A10B981"
                        BorderBrush="#4010B981"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12,5"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,14">
                    <TextBlock Text="🔓 CONFIDENTIAL APPLICATION CONTENTS VISIBLE (UNLOCKED)"
                               Foreground="#34D399"
                               FontSize="11.5"
                               FontWeight="Bold"/>
                </Border>

                <TextBlock Text="Secret Agent Task &amp; Financial Model"
                           Foreground="#F8FAFC"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <TextBlock Text="This window simulates an application (like Antigravity IDE) working on something important while minimized. Try minimizing this window — BioShield will immediately arm the lock while this background task keeps running!"
                           Foreground="#94A3B8"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           Margin="0,0,0,20"/>

                <!-- Live Background Job Progress Box -->
                <Border Background="#090D16"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,16"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="LIVE BACKGROUND WORKER STATUS (CONTINUES WHILE MINIMIZED):"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="TaskProgressText"
                                   Text="Iteration #1 • Processing confidential neural weights... (Elapsed: 00:00)"
                                   Foreground="#38BDF8"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <ProgressBar x:Name="TaskProgressBar"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="35"
                                     Foreground="#10B981"
                                     Background="#1E293B"
                                     BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="🗕  Minimize Now (Arms Fingerprint/PIN Lock)"
                            Click="MinimizeTestButton_Click"
                            Height="40"
                            Padding="18,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="0,0,12,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Close Demo App"
                            Click="CloseDemoButton_Click"
                            Height="40"
                            Padding="16,0"
                            Background="#1E293B"
                            Foreground="#CBD5E1"
                            BorderThickness="0"
                            FontSize="13"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
